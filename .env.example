# PostgreSQL connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jalur_b

# Enable SQL echo / FastAPI debug mode
DEBUG=false

# Public application URLs. Do not include trailing slashes.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Comma-separated exact origins. For Vercel previews, set a project-specific regex,
# for example: ^https://jalur-b-[a-z0-9-]+-your-team\.vercel\.app$
CORS_ALLOW_ALL=true
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=60

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq OpenAI-compatible API credentials.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_TOKENS=4096

# Protects draft refresh and approval endpoints for reviewed market baselines.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MARKET_BASELINE_ADMIN_KEY=

# SMTP delivery for verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_TLS=false

# Local development only. Ignored unless DEBUG=true and SMTP is unset.
AUTH_DEV_AUTO_VERIFY_EMAIL=true

# Supabase Storage S3-compatible API for private evidence attachments.
# Create a private bucket and S3 access keys in the Supabase dashboard.
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your-project-region
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=career-evidence
